---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogRail from '../components/CatalogRail.astro';
import { brand, formula, formulaAgent, formulaDetail, tagline } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout>
	<section class="hero" aria-label="Hero">
		<CatalogRail />
		<div class="hero-inner">
			<p class="brand-mark">{brand}</p>
			<h1>Not generate-and-pray. Decide, then act.</h1>
			<p class="lede">{tagline}</p>
			<div class="ctas">
				<a class="btn primary" href={`${base}docs/quick-start/`}>Quick start</a>
				<a class="btn" href={`${base}how/`}>How it works</a>
			</div>
		</div>
	</section>

	<section class="section formula-sec" aria-labelledby="formula-title">
		<h2 id="formula-title" class="visually-hidden">Composition</h2>
		<div class="formula-board" role="group" aria-label="Escalane versus agent">
			<p class="eq muted"><span class="eq-label">Industry</span> <code>{formulaAgent}</code></p>
			<p class="eq primary"><span class="eq-label">{brand}</span> <code>{formula}</code></p>
			<p class="eq-sub">
				Same loop energy as an agent — closed action set. Expanded: <code>{formulaDetail}</code>. Agents
				<em>propose</em> tools; Escalane <em>selects</em> among authored playbooks.
			</p>
		</div>
	</section>

	<section class="section" aria-labelledby="split-title">
		<h2 id="split-title">Two jobs. One boundary.</h2>
		<p class="section-lede">
			Language models are good at judgment. They are bad authors of production argv. Escalane keeps
			those roles apart — decide among a catalog, then act.
		</p>
		<div class="split">
			<div>
				<h3>Decide</h3>
				<p>
					System One answers typed questions — playbook <code>choice</code>, safe-to-act
					<code>noul</code>, blast <code>score</code> — over a frozen catalog plus <code>escalate</code>.
				</p>
			</div>
			<div>
				<h3>Act</h3>
				<p>
					The harness binds params from inventory, runs gates, renders argv from templates only, dry-runs
					by default, and writes an episode audit. The model never invents shell.
				</p>
			</div>
		</div>
	</section>

	<section class="section beats" aria-labelledby="beats-title">
		<h2 id="beats-title">What you can prove</h2>
		<ul>
			<li>
				<strong>Catalog</strong> — every mutate is a configured playbook (SysOps, Databricks CLI, homelab
				Docker/systemd).
			</li>
			<li>
				<strong>Gates</strong> — A0–A3 ordered vetoes; choice-only automation is not the product.
			</li>
			<li>
				<strong>Audit</strong> — catalog hash, state digest, answers, gate steps, argv in episode JSONL.
			</li>
		</ul>
		<p class="note">
			Research prototype (<code>escalane</code>). Seed eval numbers are claim-fenced — see
			<a href={`${base}docs/claims/`}>Claims</a>.

		</p>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(92vh, 52rem);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(12, 18, 16, 0.25) 0%,
			rgba(12, 18, 16, 0.55) 45%,
			rgba(12, 18, 16, 0.92) 100%
		);
		z-index: 1;
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		z-index: 2;
		max-width: var(--max);
		width: 100%;
		margin: 0 auto;
		padding: 4rem 1.25rem 3.5rem;
	}

	.brand-mark {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		letter-spacing: -0.045em;
		line-height: 0.95;
		margin: 0 0 1rem;
		color: var(--ink);
		animation: rise 0.7s var(--ease) both;
	}

	.hero h1 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(1.15rem, 2.4vw, 1.55rem);
		letter-spacing: -0.02em;
		max-width: 22ch;
		margin: 0 0 0.75rem;
		color: var(--accent);
		animation: rise 0.7s var(--ease) 0.08s both;
	}

	.lede {
		max-width: 36rem;
		margin: 0 0 1.5rem;
		color: var(--ink-muted);
		font-size: 1.05rem;
		animation: rise 0.7s var(--ease) 0.14s both;
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		animation: rise 0.7s var(--ease) 0.2s both;
	}

	.btn {
		display: inline-block;
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--line);
		color: var(--ink);
		text-decoration: none;
		font-size: 0.95rem;
		transition: border-color 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease);
	}

	.btn:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-1px);
	}

	.btn.primary {
		background: var(--accent);
		color: var(--bg-deep);
		border-color: var(--accent);
		font-weight: 500;
	}

	.btn.primary:hover {
		background: #dff98a;
		color: var(--bg-deep);
	}

	.section {
		max-width: var(--max);
		margin: 0 auto;
		padding: 3.5rem 1.25rem 1rem;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.formula-sec {
		padding-top: 2.5rem;
		padding-bottom: 0;
	}

	.formula-board {
		border: 1px solid var(--line);
		background: var(--bg-elev);
		padding: 1.35rem 1.5rem;
		animation: rise 0.7s var(--ease) 0.12s both;
	}

	.eq {
		font-family: var(--font-mono);
		font-size: clamp(0.95rem, 2vw, 1.15rem);
		margin: 0 0 0.65rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: baseline;
	}

	.eq.muted {
		color: var(--ink-muted);
	}

	.eq.primary {
		color: var(--ink);
		margin-bottom: 1rem;
	}

	.eq-label {
		font-family: var(--font-display);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent-dim);
		min-width: 5.5rem;
	}

	.eq code {
		color: inherit;
		font-size: inherit;
	}

	.eq.primary code {
		color: var(--accent);
	}

	.eq-sub {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.95rem;
		max-width: 40rem;
		line-height: 1.5;
	}

	.eq-sub code {
		font-size: 0.88em;
		color: var(--accent-dim);
	}

	.eq-sub em {
		font-style: normal;
		color: var(--ink);
		font-weight: 500;
	}

	.section h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.5rem, 3vw, 2rem);
		letter-spacing: -0.03em;
		margin: 0 0 0.75rem;
	}

	.section-lede {
		max-width: 40rem;
		color: var(--ink-muted);
		margin: 0 0 2rem;
	}

	.split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		border-top: 1px solid var(--line);
		padding-top: 1.75rem;
	}

	.split h3 {
		font-family: var(--font-display);
		font-size: 1.15rem;
		margin: 0 0 0.5rem;
		color: var(--accent);
	}

	.split p {
		margin: 0;
		color: var(--ink-muted);
	}

	.split code,
	.beats code {
		font-size: 0.88em;
		color: var(--accent-dim);
	}

	.beats ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
	}

	.beats li {
		border-left: 2px solid var(--line);
		padding-left: 1rem;
		color: var(--ink-muted);
	}

	.beats strong {
		color: var(--ink);
		font-weight: 500;
	}

	.note {
		margin-top: 1.75rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	@media (max-width: 720px) {
		.split {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: min(88vh, 40rem);
		}
	}
</style>
